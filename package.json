{
  "name": "bonk-de-los-dioses",
  "version": "1.0.0",
  "private": true,
  "description": "Roguelike 3D de supervivencia con dioses de todas las mitologías.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/dev.mjs",
    "test": "node tests/smoke.test.mjs",
    "bot": "node tests/bot.mjs",
    "lint": "eslint src scripts tests",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "three": "0.128.0"
  },
  "devDependencies": {
    "esbuild": "0.23.1",
    "eslint": "9.9.1",
    "@eslint/js": "9.9.1",
    "globals": "15.9.0",
    "playwright": "1.63.0",
    "prettier": "3.3.3"
  },
  "engines": { "node": ">=18" }
}
